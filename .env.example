# Server-only connection to the shared Neon feature-configuration database.
FEATURE_CONFIG_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional fallback for local development or non-branching Neon integrations.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Neon Managed Better Auth values. The Neon/Vercel integration injects the
# branch-specific base URL when Auth and Preview branching are enabled. The app
# derives the matching JWKS URL from this value.
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint.example
# Optional legacy fallback used only when no Neon Auth base URL is available.
NEON_AUTH_JWKS_URL=https://your-neon-auth-endpoint.example/.well-known/jwks.json

# Optional additional JWT claim checks when declared by the issued token.
# NEON_AUTH_ISSUER=https://your-neon-auth-endpoint.example
# NEON_AUTH_AUDIENCE=your-optional-audience

# Exact owner identity allowlist. Prefer the immutable Auth user subject id.
ADMIN_OWNER_EMAILS=owner@example.com
# ADMIN_OWNER_IDS=neon-auth-owner-subject-id

# Comma-separated portfolio origins allowed to submit admin mutations.
ADMIN_TRUSTED_ORIGINS=https://portfolio.example.com,https://preview.example.com

# Local development only. Never configure this variable in Vercel.
ADMIN_LOCAL_TOKEN=replace-with-a-long-local-secret
ADMIN_LOCAL_OWNER_EMAIL=owner@example.com

# Server-only token for the authenticated v1.7 Vercel analytics adapter.
VERCEL_API_TOKEN=replace-with-a-vercel-access-token

# Vercel supplies these system variables automatically in deployments.
# Set them only when exercising the real adapter outside Vercel.
# VERCEL_PROJECT_ID=prj_example
# VERCEL_TEAM_ID=team_example

# Optional owner-only destination for the Speed Insights action.
# VERCEL_ANALYTICS_DASHBOARD_URL=https://vercel.com/your-team/your-project/analytics
